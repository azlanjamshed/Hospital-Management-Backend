generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// USER
// ========================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(PATIENT)

  patient Patient?
  doctor  Doctor?

  memberships OrganizationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// ORGANIZATION / HOSPITAL
// ========================================

model Organization {
  id   String           @id @default(uuid())
  name String
  type OrganizationType @default(HOSPITAL)

  timezone String  @default("Asia/Kolkata")
  address  String?
  phone    String?
  email    String?

  status OrganizationStatus @default(ACTIVE)

  members            OrganizationMember[]
  doctors            Doctor[]
  departments        Department[]
  patients           PatientOrganization[]
  appointments       Appointment[]
  appointmentWindows AppointmentWindow[]
  consultations      Consultation[]
  patientSequence    OrganizationPatientSequence?
  dailyTokenCounters DoctorDailyTokenCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// ORGANIZATION MEMBERS
// ========================================

model OrganizationMember {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  role   StaffRole
  status MembershipStatus @default(ACTIVE)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ========================================
// PATIENT
// ========================================

model Patient {
  id     String @id @default(uuid())
  userId String @unique

  name        String
  dateOfBirth DateTime?
  gender      Gender?

  user User @relation(fields: [userId], references: [id])

  phones        PatientPhone[]
  organizations PatientOrganization[]
  appointments  Appointment[]
  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// PATIENT PHONE
// ========================================

model PatientPhone {
  id        String  @id @default(uuid())
  patientId String
  phone     String
  isPrimary Boolean @default(false)
  verified  Boolean @default(false)

  patient Patient @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())

  @@unique([patientId, phone])
  @@index([phone])
}

// ========================================
// PATIENT ↔ HOSPITAL
// ========================================

model PatientOrganization {
  id             String @id @default(uuid())
  patientId      String
  organizationId String

  hospitalPatientNumber String

  patient      Patient      @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, organizationId])
  @@unique([organizationId, hospitalPatientNumber])
  @@index([organizationId])
}

// ========================================
// DOCTOR
// ========================================

model Doctor {
  id             String  @id @default(uuid())
  organizationId String
  userId         String? @unique

  name                 String
  qualification        String?
  registrationNumber   String?
  consultationFeeMinor Int?

  followUpPeriodDays Int @default(30)

  status             DoctorStatus             @default(ACTIVE)
  availabilityStatus DoctorAvailabilityStatus @default(AVAILABLE)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  departments        DoctorDepartment[]
  schedules          Schedule[]
  appointments       Appointment[]
  appointmentWindows AppointmentWindow[]
  consultations      Consultation[]
  dailyTokenCounters DoctorDailyTokenCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ========================================
// DEPARTMENT
// ========================================

model Department {
  id             String @id @default(uuid())
  organizationId String

  name         String
  status       DepartmentStatus   @default(ACTIVE)
  organization Organization       @relation(fields: [organizationId], references: [id])
  doctors      DoctorDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ========================================
// DOCTOR ↔ DEPARTMENT
// ========================================

model DoctorDepartment {
  doctorId     String
  departmentId String

  doctor     Doctor     @relation(fields: [doctorId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([doctorId, departmentId])
}

// ========================================
// DOCTOR SCHEDULE
// ========================================

model Schedule {
  id       String @id @default(uuid())
  doctorId String

  weekday   Int
  startTime String
  endTime   String

  doctor Doctor @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
}

// ========================================
// APPOINMENT WINDOW
// ========================================

model AppointmentWindow {
  id             String @id @default(uuid())
  organizationId String
  doctorId       String

  date      DateTime
  startTime String?
  endTime   String?

  capacity Int?
  status   AppointmentWindowStatus @default(CLOSED)

  organization Organization @relation(fields: [organizationId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, date])
  @@index([organizationId, date])
}

// ========================================
// APPOINTMENT
// ========================================

model Appointment {
  id             String @id @default(uuid())
  organizationId String
  patientId      String
  doctorId       String

  appointmentWindowId String?

  appointmentDate DateTime
  startAt         DateTime
  endAt           DateTime

  tokenNumber Int?

  patientType PatientType       @default(NEW)
  source      AppointmentSource @default(PATIENT_APP)
  status      AppointmentStatus @default(PENDING)

  consultationFeeMinor Int

  organization      Organization       @relation(fields: [organizationId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  appointmentWindow AppointmentWindow? @relation(fields: [appointmentWindowId], references: [id])

  payment      Payment?
  queue        QueueEntry?
  consultation Consultation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, appointmentDate, tokenNumber])
  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([doctorId, startAt])
}

// ========================================
// PAYMENT
// ========================================

model Payment {
  id            String @id @default(uuid())
  appointmentId String @unique

  amountMinor Int
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  transactionId String?
  paidAt        DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
}

// ========================================
// QUEUE / TOKEN
// ========================================

model QueueEntry {
  id            String @id @default(uuid())
  appointmentId String @unique

  status QueueStatus @default(WAITING)

  checkedInAt DateTime?
  calledAt    DateTime?
  completedAt DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// CONSULTATION
// ========================================

model Consultation {
  id             String @id @default(uuid())
  appointmentId  String @unique
  patientId      String
  doctorId       String
  organizationId String

  chiefComplaint String?
  diagnosis      String?
  notes          String?
  doctorRemarks  String?

  startedAt   DateTime?
  completedAt DateTime?

  appointment  Appointment  @relation(fields: [appointmentId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
}

// ========================================
// ORGANIZATION PATIENT SEQUENCE (MRN)
// ========================================

model OrganizationPatientSequence {
  id             String @id @default(uuid())
  organizationId String @unique
  lastNumber     Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// DOCTOR DAILY TOKEN COUNTER
// ========================================

model DoctorDailyTokenCounter {
  id             String   @id @default(uuid())
  organizationId String
  doctorId       String
  date           DateTime
  lastToken      Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, date])
  @@index([organizationId, date])
}

// ========================================
// ENUMS
// ========================================

enum UserRole {
  PATIENT
  STAFF
  DOCTOR
  SUPER_ADMIN
}

enum StaffRole {
  ADMIN
  RECEPTIONIST
  NURSE
  MANAGER
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  MEDICAL_CENTER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientType {
  NEW
  EXISTING
  FOLLOW_UP
}

enum AppointmentSource {
  PATIENT_APP
  STAFF
  WHATSAPP
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  ONLINE
  PAY_AT_HOSPITAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentWindowStatus {
  CLOSED
  OPEN
  FULL
}

enum DoctorAvailabilityStatus {
  AVAILABLE
  ON_LUNCH
  IN_OT
  IN_CONSULTATION
  UNAVAILABLE
}
